{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "https://sacrament-subduing-confined.ngrok-free.dev/api/v1/r/:code"
    }
  ]
}
